# constrained_120km: full_120km with the AOD constraint on. The tropospheric
# aerosol is scaled hourly toward MODIS/VIIRS optical depth at 550 nm.
# Sourced by scripts/run_case.sh; values may be overridden on its command line.
# Needs: everything full_120km needs, and observation files on this mesh
#        for the days of the run (see README.md).


CASE_MESH=x1.40962            # mesh prefix under $G2G_WORK/inputs/mesh/
CASE_CYCLE=2024101500         # GFS analysis and MERRA-2 file, YYYYMMDDHH
CASE_HOURS=24                 # default run length
CASE_RANKS=8                  # MPI ranks; a matching graph partition file must exist
CASE_HISTORY_INTERVAL=6:00:00 # full-state history files are about 0.66 GB each
CASE_BACKGROUND=yes           # BACKGROUND_{sulf,dms,ptrop}.dat from Derecho
CASE_MERRA2=yes               # MERRA2:<start time> from Derecho
CASE_OPTICS_DIR=derecho/input/optics_files
CASE_OPTICS="BC.v1_5 BRC.v2_5 OC.v1_5 DU.v15_5 NI.v2_5 SS.v3_5 SU.v2_5"
CASE_EMISSIONS=regridded      # files from scripts/regrid_emissions.sh
CASE_AOD_OBS=files            # daily observation files under $G2G_WORK/inputs/aod_obs/<mesh>/
