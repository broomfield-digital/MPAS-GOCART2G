# natural_120km: dust and sea salt on the 120-km global mesh, cold start.
# Sourced by scripts/run_case.sh; values may be overridden on its command line.

CASE_MESH=x1.40962            # mesh prefix under $G2G_WORK/inputs/mesh/
CASE_CYCLE=2024101500         # GFS analysis, YYYYMMDDHH (the tutorial's Example-1 date)
CASE_HOURS=3                  # default run length
CASE_RANKS=8                  # MPI ranks; a matching graph partition file must exist
CASE_HISTORY_INTERVAL=6:00:00 # full-state history files are about 0.66 GB each
CASE_OPTICS="DU.v15_3 SS.v3_3" # Mie tables to link, one per enabled component
